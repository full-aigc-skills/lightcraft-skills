{
  "schema": "craft-scenario-playbooks/v1",
  "application": "lightcraft",
  "id": "portrait-develop",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "列出本库真实照片ID、相机与previewOnly，避免受当前视图过滤遗漏",
      "command": "catalog.query",
      "params": {
        "filter": {}
      }
    },
    {
      "purpose": "将实际目标设为唯一选择和active，后续无ids方法才作用正确",
      "command": "library.select",
      "params": {
        "ids": [
          "$target.id"
        ],
        "active": "$target.id",
        "mode": "replace"
      }
    },
    {
      "purpose": "查看当前后端实际控制范围",
      "command": "develop.controls",
      "params": {}
    },
    {
      "purpose": "只对目标作整体曝光试调，并非脸部局部蒙版",
      "command": "develop.set",
      "params": {
        "control": "light.exposure",
        "value": 0.15,
        "ids": [
          "$target.id"
        ]
      }
    },
    {
      "purpose": "逐目标回读曝光，不只看当前active",
      "command": "develop.get",
      "params": {
        "id": "$target.id"
      }
    },
    {
      "purpose": "导出明确目标的自然人像试样，不放大小图",
      "command": "app.export",
      "params": {
        "ids": [
          "$target.id"
        ],
        "path": "output/portrait-proof.jpg",
        "longEdge": 1600,
        "dontEnlarge": true,
        "colorSpace": "srgb"
      }
    }
  ],
  "check": "肤色、头颈和背景关系自然，100%检查噪声与皮肤纹理。",
  "boundary": "示例0.15EV是整张照片曝光，不是脸部自动选择或皮肤修复；先按实际人像试调并查看肤色、纹理和高光。需要局部蒙版时另查后端真实能力或交PhotoCraft。ID、1600长边和输出路径需按实际任务替换，dontEnlarge不增加细节。",
  "templateOnly": true,
  "argumentPolicy": "先从catalog.query选择当前库真实ID；$target.id/$sample.id替换为整数，$targets.photoIds整字段替换为非空扁平整数数组。路径与数值为示例，不能未绑定直接执行。"
}
