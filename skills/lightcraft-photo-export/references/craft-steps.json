{
  "schema": "craft-scenario-playbooks/v1",
  "application": "lightcraft",
  "id": "photo-export",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "核对选片与图库状态",
      "command": "library.info",
      "params": {}
    },
    {
      "purpose": "查看实际导出预设",
      "command": "export.presets",
      "params": {}
    },
    {
      "purpose": "输出网页交付版并移除位置元数据",
      "command": "app.export",
      "params": {
        "dir": "output/web",
        "longEdge": 2000,
        "dontEnlarge": true,
        "format": "jpeg",
        "quality": 90,
        "colorSpace": "srgb",
        "removeLocation": true,
        "conflict": "unique"
      }
    }
  ],
  "check": "数量、文件名、尺寸、颜色、锐化和可解码性一致，抽查元数据。",
  "boundary": "当前选择与导出范围先核对；Web库需另外备份，JPEG交付不等于图库工程已保存到workspace。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
