{
  "schema": "craft-scenario-playbooks/v1",
  "application": "lightcraft",
  "id": "landscape-develop",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "先检查当前设置",
      "command": "develop.get",
      "params": {}
    },
    {
      "purpose": "校正地平线并保留最大可用裁切",
      "command": "crop.straighten",
      "params": {
        "angle": 1
      }
    },
    {
      "purpose": "小幅平衡整体曝光",
      "command": "develop.set",
      "params": {
        "control": "light.exposure",
        "value": 0.2
      }
    },
    {
      "purpose": "输出检查层次",
      "command": "app.export",
      "params": {
        "path": "output/landscape-proof.jpg",
        "longEdge": 1600,
        "dontEnlarge": true,
        "colorSpace": "srgb"
      }
    }
  ],
  "check": "山脊与建筑无光晕，天空无色带，地平线与裁切正确。",
  "boundary": "角度需由实际水平参考测量；天空局部调整另查当前mask能力，不假定自动天空选择。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
