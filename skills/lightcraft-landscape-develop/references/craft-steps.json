{
  "schema": "craft-scenario-playbooks/v1",
  "application": "lightcraft",
  "id": "landscape-develop",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "列出本库真实照片ID、相机与previewOnly，避免受当前视图过滤遗漏",
      "command": "catalog.query",
      "params": {
        "filter": {}
      }
    },
    {
      "purpose": "将实际目标设为唯一选择和active，后续无ids方法才作用正确",
      "command": "library.select",
      "params": {
        "ids": [
          "$target.id"
        ],
        "active": "$target.id",
        "mode": "replace"
      }
    },
    {
      "purpose": "读取目标原有显影设置",
      "command": "develop.get",
      "params": {
        "id": "$target.id"
      }
    },
    {
      "purpose": "按已测水平参考校正当前明确选择的目标",
      "command": "crop.straighten",
      "params": {
        "angle": 1
      }
    },
    {
      "purpose": "仅平衡目标曝光",
      "command": "develop.set",
      "params": {
        "control": "light.exposure",
        "value": 0.2,
        "ids": [
          "$target.id"
        ]
      }
    },
    {
      "purpose": "只输出该目标的风景试样",
      "command": "app.export",
      "params": {
        "ids": [
          "$target.id"
        ],
        "path": "output/landscape-proof.jpg",
        "longEdge": 1600,
        "dontEnlarge": true,
        "colorSpace": "srgb"
      }
    }
  ],
  "check": "山脊与建筑无光晕，天空无色带，地平线与裁切正确。",
  "boundary": "角度1度须由真实水平参考测量后替换；控制ID是crop.angle，develop.get返回值从crop.geometry.angle回读，两者路径不同；crop.straighten依赖当前选择，因此必须先把目标设为唯一选择/active。裁切会损失边缘，先检查主体与最大可用区域；天空局部调整另查mask，不假定自动选天。",
  "templateOnly": true,
  "argumentPolicy": "先从catalog.query选择当前库真实ID；$target.id/$sample.id替换为整数，$targets.photoIds整字段替换为非空扁平整数数组。路径与数值为示例，不能未绑定直接执行。",
  "limitedTechnicalValidation": {
    "mainRun": 39013647220,
    "stableMatrixRun": 39013640352,
    "nativeMainCommit": "f34c7a8a89e0d1bade0a6889185f40acecc84a9f",
    "targetPhotoAndUnselectedProtection": "PASS",
    "nativeReopen": "PASS",
    "creativeVisualAcceptance": "NOT_TESTED",
    "installedHostSync": "NOT_TESTED"
  }
}
